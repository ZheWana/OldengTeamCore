{
  "name": "team-core",
  "version": "0.1.25",
  "description": "Cross-platform Oldeng Team Core collaboration plugin for Obsidian",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs development",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "npm run lint:code && npm run lint:css && npm run lint:obsidian",
    "lint:code": "eslint . --max-warnings 0",
    "lint:css": "stylelint styles.css",
    "lint:obsidian": "node scripts/obsidian-lint.mjs",
    "check": "npm run build && npm run typecheck && npm test && npm run lint",
    "verify-release": "node scripts/verify-release.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.1",
    "jiti": "^2.6.1",
    "obsidian": "^1.12.3",
    "obsidian-plugin-validator": "^1.0.6",
    "stylelint": "^16.26.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZheWana/OldengTeamCore.git"
  },
  "homepage": "https://github.com/ZheWana/OldengTeamCore#readme",
  "bugs": {
    "url": "https://github.com/ZheWana/OldengTeamCore/issues"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "diff3": "0.0.4",
    "fflate": "^0.8.3",
    "hash-wasm": "^4.12.0",
    "isomorphic-git": "^1.27.2"
  }
}
